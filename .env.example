# Copy to .env (never commit .env) and fill in. This value is public: it ends up in the page.

# Optional: Meta Pixel / dataset ID from Events Manager (numbers only). Empty = Meta Pixel off.
# It loads only after the visitor accepts cookies (or by default outside the EEA/UK/CH).
VITE_META_PIXEL_ID=

# The opt-in form endpoint and FirstPromoter sub-ID parameter are set in src/lib/config.ts
# (FORM_ENDPOINT_URL and SUBID_PARAM).
