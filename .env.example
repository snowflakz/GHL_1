# Copy to .env (never commit .env) and fill in. Both values are public: they end up in the page.

# Meta Pixel / dataset ID from Events Manager (numbers only). Empty = pixel off.
VITE_META_PIXEL_ID=

# Optional: where the pre-checkout popup POSTs the email (JSON body: email, firstName, offer, placement, page, submitted_at).
# Easiest: a HighLevel workflow with an "Inbound Webhook" trigger -> Create/Update Contact -> follow-up emails.
VITE_LEAD_WEBHOOK_URL=
